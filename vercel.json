{
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/socket-io.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/client/index.html"
    },
    {
      "source": "/api/socket-io/:path*",
      "destination": "/api/socket-io"
    },
    {
      "source": "/socket.io-client.js",
      "destination": "/client/socket.io-client.js"
    },
    {
      "source": "/vendor/xlsx/:path*",
      "destination": "/api/http?route=api/vendor/xlsx/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/http?route=api/health"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/http?route=api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/client/:path*"
    }
  ]
}
