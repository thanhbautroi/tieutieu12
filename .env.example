# Sao chép file này thành .env, điền giá trị thật và KHÔNG commit file .env lên Git.

# Cổng chạy web và server real-time
PORT=3001
TRUST_PROXY=0

# Chuỗi MongoDB Atlas đầy đủ, lấy trong Atlas > Connect > Drivers.
# Thay username, password đã URL-encode, hostname cluster và tên database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/tieu_tieu?retryWrites=true&w=majority
DB_NAME=tieu_tieu

# Chỉ dùng để khởi tạo tài khoản quản trị đầu tiên qua POST /api/auth/bootstrap-admin.
# Hãy đặt chuỗi ngẫu nhiên dài, sau đó xóa biến này và khởi động lại server.
ADMIN_BOOTSTRAP_TOKEN=
